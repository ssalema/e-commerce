{
  "name": "ecommerce-server",
  "version": "1.0.0",
  "description": "Premium MERN e-commerce REST API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:destroy": "node src/seed/seed.js --destroy",
    "admin:create": "node scripts/admin.js create",
    "admin:reset-password": "node scripts/admin.js reset-password",
    "email:preview": "node scripts/email-preview.js --open",
    "invoice:preview": "node scripts/invoice-preview.js --open",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate:invoiced-at": "node scripts/backfill-invoiced-at.js",
    "webhook:test": "node scripts/webhook-test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.9",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.4",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=22.23.5"
  }
}
