# ---------- Core ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ---------- Database ----------
MONGO_URI=mongodb://127.0.0.1:27017/premium-ecommerce

# ---------- Auth ----------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=12

# ---------- Account lockout ----------
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# ---------- Login sessions (the "Manage devices" screen) ----------
SESSION_INACTIVITY_DAYS=30
SESSION_TOUCH_INTERVAL_SECONDS=60
SESSION_MAX_PER_USER=20

# ---------- Approximate login location ----------
GEOIP_ENABLED=true
GEOIP_URL=http://ip-api.com/json/{ip}?fields=status,country,countryCode,regionName,city
GEOIP_TIMEOUT_MS=2000

# ---------- Google sign-in ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Proxy hops in front of this process ----------
TRUST_PROXY_HOPS=1

# ---------- CORS (comma separated) ----------
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ---------- Serve the storefront from this process (optional) ----------
CLIENT_DIST_PATH=

# ---------- Public origin of this API ----------
SERVER_URL=

# ---------- Cloudinary ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=premium-ecommerce

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Mail (verification codes, password reset) ----------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Premium Store <no-reply@example.com>"

SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_GREETING_TIMEOUT_MS=8000
SMTP_SOCKET_TIMEOUT_MS=12000
MAIL_SEND_TIMEOUT_MS=12000

REQUEST_TIMEOUT_MS=25000